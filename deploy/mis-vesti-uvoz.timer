[Unit]
Description=Повлачи музејске вести са nhmbeo.rs три пута дневно

[Timer]
# 07:15, 13:15 и 19:15 — довољно често да страна буде свежа, ретко довољно
# да не оптерећује туђи сајт. Persistent=true надокнађује пропуштено
# покретање после гашења сервера.
OnCalendar=*-*-* 07,13,19:15:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
