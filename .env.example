# Museum Information System Configuration
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
# Generate a strong secret key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this-to-random-64-char-string
FLASK_DEBUG=False
FLASK_ENV=production

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Session Configuration
# Production ZAHTEVA redis (ProductionConfig odbija start sa filesystem);
# filesystem je samo za razvoj/testove.
SESSION_TYPE=redis
SESSION_PERMANENT=False
SESSION_USE_SIGNER=True
SESSION_KEY_PREFIX=museum:
PERMANENT_SESSION_LIFETIME=28800  # 8 hours in seconds
SESSION_COOKIE_SECURE=True  # Production ZAHTEVA True (HTTPS)
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CSRF Protection
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=3600  # 1 hour

# Rate Limiting
# Ne postavljaj RATELIMIT_STORAGE_URL osim ako baš mora da se razlikuje od
# REDIS_URL — podrazumevano prati REDIS_URL (deljeno preko svih workera).
# memory:// je PO RADNIKU i sa WORKERS > 1 produkcija odbija start.
RATELIMIT_ENABLED=True
# RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL=True

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800  # 30 minutes in seconds
SESSION_TIMEOUT_WARNING=300  # 5 minutes before timeout

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL je JEDINA baza aplikacije (izvor istine za sve module).
# Format: postgresql+psycopg://korisnik:lozinka@host:5432/ime_baze
DATABASE_URL=postgresql+psycopg://mis:your-database-password@localhost:5432/mis_db

# Connection Pooling
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# SQLite Configuration (for collections)
MINERAL_DATABASE_PATH=PrirodnjackiMuzej/prirodnjacki_muzej.sqlite
BIRD_DATABASE_PATH=data/bird_ringing.db
INVENTORY_DATABASE_PATH=data/inventory_book.db

# CIF fajlovi (kristalne strukture) — production: /data/mis/cif_files
CIF_STORAGE_DIR=./data/cif_files

# ============================================================================
# AUTHENTICATION & AUTHORIZATION
# ============================================================================
AUTH_SYSTEM_ENABLED=True
ENABLE_FALLBACK_AUTH=False  # Set to False in production!
REQUIRE_PASSWORD_CHANGE_ON_FIRST_LOGIN=True

# Default Admin Credentials (change immediately after first login!)
ADMIN_EMAIL=admin@nhmbeo.rs
ADMIN_DEFAULT_PASSWORD=change-this-immediately

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/museum_info_system.log
LOG_FORMAT=json  # Options: json, text
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=10

# Sentry Error Tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# EXTERNAL API KEYS
# ============================================================================
MINDAT_API_KEY=
RRUFF_API_KEY=

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
HOST=0.0.0.0
PORT=5555
WORKERS=4  # Number of Gunicorn workers

# Sub-application Ports
TIMESHEET_PORT=5001
MINERAL_DB_PORT=5002

# File Upload
MAX_CONTENT_LENGTH=209715200  # 200MB in bytes; keep in sync with nginx client_max_body_size
UPLOAD_FOLDER=storage/uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,xlsx,csv

# Image Storage - actual image files stored here, references in PostgreSQL
# On server, mount storage drive and set this path accordingly
# e.g. /mnt/storage/ImagesDatabase or /data/ImagesDatabase
IMAGE_STORAGE_PATH=./ImagesDatabase

# Document library - uploaded document files stored here, references in
# PostgreSQL. On production set this under /data/mis (e.g. /data/mis/dokumenti)
DOCUMENTS_STORAGE_PATH=./data/dokumenti

# Фототека - RAW originals (write-once, keep in backups; production
# /data/arhiva) and regenerable derivatives (exclude from backups;
# production /data/mis/media)
FOTOTEKA_ARHIVA_PATH=./data/arhiva
FOTOTEKA_MEDIA_PATH=./data/fototeka_media
# Samba share mount scanned by the import screen (admin picks a subpath under
# this root only). Production: the mounted share, e.g. /mnt/fototeka_ulaz
FOTOTEKA_IMPORT_PATH=./data/fototeka_import

# ============================================================================
# REDIS CONFIGURATION (optional, for caching and sessions)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=simple  # Options: simple, redis, memcached
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=museum_cache:

# ============================================================================
# EMAIL CONFIGURATION (for notifications)
# ============================================================================
MAIL_SERVER=smtp.nhmbeo.rs
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=noreply@nhmbeo.rs
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@nhmbeo.rs

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_ENABLED=True
BACKUP_DIRECTORY=/var/backups/museum
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# S3/Cloud Backup (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-central-1